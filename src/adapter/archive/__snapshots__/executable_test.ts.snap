exports[`executable headers are read without downloading the whole file 1`] = `
{
  "goreleaser": "foo_1.0.0_linux_amd64/foo",
  "linux": {
    "architectures": [
      "amd64",
    ],
    "path": "gh_2.102.0_linux_amd64/bin/gh",
  },
  "linuxStoppedEarly": true,
  "windows": {
    "architectures": [
      "amd64",
    ],
    "path": "bin/gh.exe",
  },
  "windowsNames": "bin/gh.exe",
  "windowsStartedAtTail": true,
}
`;
